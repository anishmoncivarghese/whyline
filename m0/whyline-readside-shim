#!/usr/bin/env bash
# Read-side probe. Logs every whyline invocation, then delegates unchanged.
# Deliberately incapable of altering behaviour: it never inspects or rewrites
# arguments, and any logging failure is ignored.
log="${WHYLINE_READSIDE_LOG:-$HOME/.whyline-readside.log}"
{ printf '%s\t%s\t%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    "${1:-none}" \
    "$(basename "${PWD}")" >> "$log"; } 2>/dev/null || true
exec /Users/anish/.local/share/uv/tools/whyline/bin/whyline "$@"
